{
  "version": 2,
  "routes": [
    {
      "src": "/assets/.*",
      "headers": {
        "cache-control": "public, immutable, max-age=31536000"
      },
      "continue": true
    },
    {
      "src": "/index.html",
      "headers": {
        "cache-control": "public, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
